# Application
APP_NAME=kz-ai-analytics
APP_ENV=development
SECRET_KEY=change-me-in-production-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+psycopg://kz_ai:kz_ai@postgres:5432/kz_ai
REDIS_URL=redis://redis:6379/0

# Bootstrap admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# 1C OData sources (second base URL TBD)
ODATA_ASIL_URL=https://miamor.keenetic.pro:777/test3_asil/odata/standard.odata/
ODATA_ASIL_USER=
ODATA_ASIL_PASSWORD=
ODATA_ASIL_VERIFY_SSL=false

ODATA_MIAMOR_URL=
ODATA_MIAMOR_USER=
ODATA_MIAMOR_PASSWORD=
ODATA_MIAMOR_VERIFY_SSL=false

# Sync
SYNC_ENABLED=false
SYNC_INCREMENTAL_CRON=*/15 * * * *
SYNC_FULL_CRON=0 2 * * *

# Email (quarterly digests)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
DIGEST_EMAIL=s.bacherikova@yandex.ru
TIMEZONE=Asia/Almaty

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
